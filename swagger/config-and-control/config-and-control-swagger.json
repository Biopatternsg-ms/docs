      "put": {
        "summary": "Update pipeline configuration",
        "description": "Updates an existing pipeline configuration for biological data processing workflows.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePipelineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Pipeline configuration successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Updated pipeline configuration",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "networkId": {
                      "type": "string"
                    },
                    "levels": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "step": {
                      "$ref": "#/components/schemas/PipelineSteps"
                    },
                    "expertObjects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ExpertObjectConfig"
                      }
                    },
                    "transcriptionFactorConfig": {
                      "$ref": "#/components/schemas/TranscriptionFactorConfig"
                    },
                    "createdAt": {
                      "type": "integer",
                      "format": "int32"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "Pipeline Controller"
        ]
      },
      "get": {
        "summary": "List user pipelines",
        "description": "List pipelines associates for an user with option to apply same filters",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindPipelineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User pipelines list successfully obtained",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "User pipelines obtained",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "userId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "integer",
                      "format": "int32"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Pipeline Controller"
        ]
      },
      "post": {
        "summary": "Create pipeline configuration",
        "description": "Creates a new pipeline configuration for biological data processing workflows.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePipelineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Pipeline configuration successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Created pipeline configuration",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "networkId": {
                      "type": "string"
                    },
                    "levels": {
                      "type": "integer",
                      "format": "int32"
                    },
                    "step": {
                      "$ref": "#/components/schemas/PipelineSteps"
                    },
                    "expertObjects": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ExpertObjectConfig"
                      }
                    },
                    "transcriptionFactorConfig": {
                      "$ref": "#/components/schemas/TranscriptionFactorConfig"
                    },
                    "createdAt": {
                      "type": "integer",
                      "format": "int32"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "Pipeline Controller"
        ]
      }
    },
    "/config-and-control/pipelines/launch": {
      "post": {
        "summary": "Launch pipeline execution",
        "description": "Launches the execution of a configured pipeline for biological data processing.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LaunchPipelineRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Pipeline successfully launched for execution",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "Success message with pipeline ID"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "Pipeline Controller"
        ]
      }
    },
    "/config-and-control/pipelines/update-step": {
      "patch": {
        "summary": "Update pipeline step",
        "description": "Updates a specific step within a pipeline configuration.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PipelineStepRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Pipeline step successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "Success message"
                }
              }
            }
          }
        },
        "tags": [
          "Pipeline Controller"
        ]
      }
    },
    "/config-and-control/pipelines/{id}": {
      "get": {
        "summary": "User pipeline information",
        "description": "Get pipeline information for an Id pipeline of user logged",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pipeline information successfully obtained",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Pipeline information obtained",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "userId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "integer",
                      "format": "int32"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Pipeline Controller"
        ]
      }
    },
    "/config-and-control/users": {
      "post": {
        "summary": "Register new user",
        "description": "Registers a new user in the system with the provided credentials and information.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "User successfully registered",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "Registration confirmation"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "User Controller"
        ]
      }
    },
    "/config-and-control/users/login": {
      "post": {
        "summary": "User authentication",
        "description": "Authenticates a user with provided credentials and returns an authentication token.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User successfully authenticated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Authentication token response",
                  "properties": {
                    "access_token": {
                      "type": "string"
                    },
                    "refresh_token": {
                      "type": "string"
                    },
                    "token_type": {
                      "type": "string"
                    },
                    "id_token": {
                      "type": "string"
                    },
                    "expires_in": {
                      "type": "integer",
                      "format": "int64"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "Auth Controller"
        ]
      }
    },
    "/config-and-control/users/{id}/password-recovery": {
      "get": {
        "summary": "Recover user account",
        "description": "Initiates the account recovery process for a user with the specified ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "202": {
            "description": "Account recovery process initiated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "description": "Recovery confirmation"
                }
              }
            }
          }
        },
        "tags": [
          "User Controller"
        ]
      }
    }
  },
  "info": {
    "title": "config-and-control API",
    "version": "1.0.0-SNAPSHOT"
  }
}
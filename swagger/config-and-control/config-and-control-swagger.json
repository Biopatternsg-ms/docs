{
  "openapi": "3.1.0",
  "components": {
    "schemas": {
      "CreateNetworkRequest": {
        "type": "object",
        "required": [
          "name",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "CreatePipelineRequest": {
        "type": "object",
        "required": [
          "name",
          "description",
          "networkId",
          "levels",
          "expertObjects",
          "transcriptionFactorConfig"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "networkId": {
            "type": "string"
          },
          "levels": {
            "type": "integer",
            "format": "int32"
          },
          "expertObjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpertObjectConfig"
            }
          },
          "transcriptionFactorConfig": {
            "$ref": "#/components/schemas/TranscriptionFactorConfig"
          }
        }
      },
      "ExpertObjectConfig": {
        "type": "object",
        "properties": {
          "uniprotId": {
            "type": "string"
          },
          "hgncId": {
            "type": "string"
          },
          "symbol": {
            "type": "string"
          }
        }
      },
      "FindNetworkRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "FindPipelineRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "networkId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "page": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "Genome": {
        "type": "string",
        "enum": [
          "HG38",
          "HG19"
        ]
      },
      "LaunchPipelineRequest": {
        "type": "object",
        "required": [
          "pipelineId"
        ],
        "properties": {
          "pipelineId": {
            "type": "string"
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PipelineStepRequest": {
        "type": "object",
        "required": [
          "id",
          "step"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "step": {
            "$ref": "#/components/schemas/PipelineSteps"
          }
        }
      },
      "PipelineSteps": {
        "type": "string",
        "enum": [
          "CONFIG",
          "LAUNCH",
          "TRANSCRIPTION_FACTOR",
          "EXPERT_OBJECTS",
          "SEARCH_LEVELS"
        ]
      },
      "Strand": {
        "type": "string",
        "enum": [
          "POSITIVE",
          "NEGATIVE"
        ]
      },
      "TranscriptionFactorConfig": {
        "type": "object",
        "properties": {
          "promoterRegion": {
            "type": "string"
          },
          "reliability": {
            "type": "integer",
            "format": "int32"
          },
          "start": {
            "type": "number"
          },
          "end": {
            "type": "number"
          },
          "genome": {
            "$ref": "#/components/schemas/Genome"
          },
          "track": {
            "type": "string"
          },
          "identity": {
            "type": "number",
            "format": "float"
          },
          "chromosome": {
            "type": "string"
          },
          "strand": {
            "$ref": "#/components/schemas/Strand"
          },
          "sources": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TranscriptionFactorSource"
            }
          }
        }
      },
      "TranscriptionFactorSource": {
        "type": "string",
        "enum": [
          "TFBIND",
          "JASPAR"
        ]
      },
      "UpdateNetworkRequest": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      },
      "UpdatePipelineRequest": {
        "type": "object",
        "required": [
          "id",
          "name",
          "description",
          "levels",
          "expertObjects",
          "transcriptionFactorConfig"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "levels": {
            "type": "integer",
            "format": "int32"
          },
          "expertObjects": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ExpertObjectConfig"
            }
          },
          "transcriptionFactorConfig": {
            "$ref": "#/components/schemas/TranscriptionFactorConfig"
          }
        }
      },
      "UserRequest": {
        "type": "object",
        "required": [
          "username",
          "firstName",
          "lastName",
          "password"
        ],
        "properties": {
          "username": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "lastName": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "UsersKeycloakFiltersRequest": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "search": {
            "type": "string"
          },
          "enable": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "paths": {
    "/config-and-control/admin/users": {
      "get": {
        "summary": "List keycloak users",
        "description": "List keycloak users with option to apply same filters",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsersKeycloakFiltersRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Users list successfully obtained",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Users list obtained",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "username": {
                      "type": "string"
                    },
                    "email": {
                      "type": "string"
                    },
                    "firstName": {
                      "type": "string"
                    },
                    "lastName": {
                      "type": "string"
                    },
                    "enabled": {
                      "type": "string"
                    },
                    "emailVerified": {
                      "type": "string"
                    },
                    "createdTimestamp": {
                      "type": "integer",
                      "format": "int64"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Admin Controller"
        ]
      }
    },
    "/config-and-control/networks": {
      "put": {
        "summary": "Update network configuration",
        "description": "Updates an existing network configuration for biological data processing.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateNetworkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Network configuration successfully updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Updated network configuration",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "userId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "integer",
                      "format": "int32"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "Network Controller"
        ]
      },
      "get": {
        "summary": "List user networks",
        "description": "List networks associates for an user with option to apply same filters",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FindNetworkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "User networks list successfully obtained",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "User networks obtained",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "userId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "integer",
                      "format": "int32"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Network Controller"
        ]
      },
      "post": {
        "summary": "Create network configuration",
        "description": "Creates a new network configuration for biological data processing.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateNetworkRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Network configuration successfully created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Created network configuration",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "userId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "integer",
                      "format": "int32"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Bad Request"
          }
        },
        "tags": [
          "Network Controller"
        ]
      }
    },
    "/config-and-control/networks/{id}": {
      "get": {
        "summary": "User network information",
        "description": "Get network information for an Id network of user logged",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Network information successfully obtained",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "description": "Network information obtained",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "userId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    },
                    "createdAt": {
                      "type": "integer",
                      "format": "int32"
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "Network Controller"
        ]
      }
    },

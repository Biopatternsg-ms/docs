specification {
  element user {
    style {
      shape person
    }
  }
  element system
  element container
  element externalSystem {
    style {
      color muted
    }
  }
  element group
}

model {
  customer = user 'User'

  // Definición del Sistema y sus Contenedores (Nivel 2)
  biopatternsg = system 'Biopatternsg' {
    webapp = container 'Web App'
    config_and_control = container 'ConfigAndControl'
    gateway = container 'Gateway'
    control_access = container 'ControlAccess'
    biological_objects = container 'BiologicalObjects'
    pubmed_integration = container 'PubmedIntegration'
    ontologies = container 'Ontologies'
    build_knowledge_base = container 'buildKnowledgeBase'
    rrg_building = container 'RRGBuilding'
  }

  // Servicios Externos
  group externalServices {
    title 'External Services'
    
    group ncbi {
      title 'ncbi'
      mesh = externalSystem 'MESH'
      pubtator = externalSystem 'PubTator'
      pubmed = externalSystem 'PubMed'
    }

    pdb = externalSystem 'PDB' {
      description 'Busqueda de complejos proteinicos'
    }
    hgnc = externalSystem 'HGNC'
    quickgo = externalSystem 'QuickGO'
    uniprot = externalSystem 'UniProt'
    tfbind = externalSystem 'TFbind'
    jasper = externalSystem 'Jasper'
  }

  // --- RELACIONES ---

  // Relaciones del usuario
  customer -> webapp 'uses'

  // Relaciones del Gateway
  webapp -> gateway 'Json/Https'
  gateway -> control_access 'Json/Https'
  gateway -> config_and_control 'Json/Https'
  gateway -> biological_objects 'Json/Https'
  gateway -> ontologies 'Json/Https'
  gateway -> rrg_building 'Json/Https'

  // Relaciones Bidireccionales (Se representan con dos flechas o una descriptiva)
  config_and_control -> biological_objects 'Bidirectional' { technology 'Json/Http' }
  biological_objects -> config_and_control
  
  config_and_control -> pubmed_integration 'Bidirectional' { technology 'Json/Http' }
  pubmed_integration -> config_and_control
  
  config_and_control -> build_knowledge_base 'Bidirectional' { technology 'Json/Http' }
  build_knowledge_base -> config_and_control
  
  config_and_control -> rrg_building 'Bidirectional' { technology 'Json/Http' }
  rrg_building -> config_and_control

  // Otras relaciones internas
  ontologies -> biological_objects 'Uses' { technology 'Json/Https' }

  // Relaciones con Servicios Externos
  rrg_building -> pubmed 'Uses' { technology 'Json/Https' }
  rrg_building -> pubtator 'Uses' { technology 'Json/Https' }
  ontologies -> mesh 'Uses' { technology 'Json/Https' }
  ontologies -> quickgo 'Uses' { technology 'Json/Https' }
  
  biological_objects -> pdb 'Uses' { technology 'Json/Https' }
  biological_objects -> hgnc 'Uses' { technology 'Json/Https' }
  biological_objects -> uniprot 'Uses' { technology 'Json/Https' }
  biological_objects -> tfbind 'Uses' { technology 'Json/Https' }
  biological_objects -> jasper 'Uses' { technology 'Json/Https' }
}

views {
  // Vista de Contenedores
  view containerView {
    title 'Biopattern System - Container Diagram'
    
    // Incluimos al usuario, el sistema con sus hijos y los servicios externos
    include customer
    include biopatternsg.*
    include externalServices.*
    
    autoLayout TopBottom
  }
}
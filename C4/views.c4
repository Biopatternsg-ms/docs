views {
  // Nivel 1: Contexto
  view index {
    title 'System Context Diagram'
    include customer
    include adminUser
    include biopatternsg
    include smtpService
    include pdb
    include quickgo
    include PubMed
    include uniprot
    include HGNC
    include Mesh
    include PubTator
    include TFBIND
    include JASPAR
    
    autoLayout TopBottom
  }

  // Nivel 2: Contenedores
  view containerView of biopatternsg { 
    title 'Biopatternsg - Container Diagram'
    
    include *
    include customer
    include adminUser
    
    autoLayout TopBottom
  }

  // Nivel 3: Componentes por Contenedor
  view webAppContainerView of biopatternsg.webapp {
    title 'Web App - Component Diagram'
    include *
    include customer
    include adminUser
    autoLayout TopBottom
  }

  view containerViewOfConfigAndControl of biopatternsg.config_and_control {
    title 'ConfigAndControl - Component Diagram'
    include *
    autoLayout TopBottom
  } 

  view biologicalObjectsContainerView of biopatternsg.biological_objects {
    title 'Biological Objects - Component Diagram'
    include *
    autoLayout TopBottom spline
  }

  view ontologiesContainerView of biopatternsg.ontologies {
    title 'Ontologies - Component Diagram'
    include *
    autoLayout TopBottom
  }

  view pubmedIntegrationContainerView of biopatternsg.pubmed_integration {
    title 'PubmedIntegration - Component Diagram'
    include *
    autoLayout TopBottom
  }

  view inferencesContainerView of biopatternsg.inferences {
    title 'Inferences - Component Diagram'
    include *
    autoLayout TopBottom
  }

  view integrationsContainerView of biopatternsg.integrations {
    title 'Integrations - Component Diagram'
    include *
    autoLayout TopBottom
  }

  view buildKnowledgeBaseContainerView of biopatternsg.build_knowledge_base {
    title 'BuildKnowledgeBase - Component Diagram'
    include *
    autoLayout TopBottom
  }

}
